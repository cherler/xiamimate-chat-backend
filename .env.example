# Phase 4 shadow validation defaults
XIAMIMATE_BASELINE_ROOT=/absolute/path/to/xiamimate
XIAMIMATE_PYTHON_BIN=/absolute/path/to/python

PG_HOST=localhost
PG_PORT=5432
PG_DB=xiamimate
PG_USER=xiamimate
PG_PASSWORD=xiamimate

CHAT_BACKEND_HOST=0.0.0.0
CHAT_BACKEND_PORT=8200
CHAT_BACKEND_BASE_URL=http://127.0.0.1:8200
# 用户看到的 portal / Open WebUI 外部入口
CHAT_BACKEND_PUBLIC_PORTAL_BASE_URL=http://127.0.0.1:3002
# backend 自己回调 Open WebUI /api/v1/auths/ 的内部入口
CHAT_BACKEND_INTERNAL_PORTAL_BASE_URL=http://127.0.0.1:3002
# 兼容旧配置；建议迁移到上面两个新变量
# CHAT_BACKEND_PORTAL_BASE_URL=http://127.0.0.1:3002
CHAT_BACKEND_SERVICE_SECRET=
CHAT_BACKEND_ADMIN_TOKEN=
CHAT_BACKEND_GUEST_DAILY_USERNAMES=guest
CHAT_BACKEND_GUEST_DAILY_POINTS=500
CHAT_BACKEND_SIGNUP_GIFT_POINTS=500
CHAT_BACKEND_REFERRAL_INVITED_REWARD_POINTS=500
CHAT_BACKEND_REFERRAL_INVITER_REWARD_POINTS=500
CHAT_BACKEND_DAILY_RESET_TIMEZONE=Asia/Shanghai
CHAT_BACKEND_DISABLE_DEMO_FALLBACK=false

XIAMIMATE_THEME_API_BASE_URL=http://127.0.0.1:18100
XIAMIMATE_THEME_API_KEY=
XIAMIMATE_THEME_API_TIMEOUT=120

DIFY_BASE_URL=
DIFY_WORKFLOW_APP_API_KEY=
DIFY_WEB_SEARCH_APP_ID=
DIFY_WEB_SEARCH_APP_API_KEY=
DIFY_DATASET_API_KEY=
DIFY_DATASET_IDS=
