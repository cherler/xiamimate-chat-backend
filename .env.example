# Phase 4 shadow validation defaults
XIAMIMATE_BASELINE_ROOT=/absolute/path/to/xiamimate
XIAMIMATE_PYTHON_BIN=/absolute/path/to/python

PG_HOST=localhost
PG_PORT=15436
PG_DB=xiamimate
PG_USER=xiamimate
PG_PASSWORD=xiamimate

CHAT_BACKEND_HOST=0.0.0.0
CHAT_BACKEND_PORT=8200
CHAT_BACKEND_BASE_URL=http://127.0.0.1:8200
# 用户看到的 portal / Open WebUI 外部入口
CHAT_BACKEND_PUBLIC_PORTAL_BASE_URL=http://127.0.0.1:3002
# backend 自己回调 Open WebUI /api/v1/auths/ 的内部入口
CHAT_BACKEND_INTERNAL_PORTAL_BASE_URL=http://127.0.0.1:3002
# chat-backend 回写 Open WebUI 本地账号库时使用的 sqlite 文件路径
CHAT_BACKEND_OPENWEBUI_DB_PATH=/absolute/path/to/xiamimate-openwebui-bridge/data/open-webui/webui.db
# 兼容旧配置；建议迁移到上面两个新变量
# CHAT_BACKEND_PORTAL_BASE_URL=http://127.0.0.1:3002
CHAT_BACKEND_SERVICE_SECRET=
CHAT_BACKEND_ADMIN_TOKEN=
CHAT_BACKEND_PASSWORD_RESET_MIN_LENGTH=8
CHAT_BACKEND_GUEST_DAILY_USERNAMES=guest
CHAT_BACKEND_GUEST_DAILY_POINTS=500
CHAT_BACKEND_SIGNUP_GIFT_POINTS=500
CHAT_BACKEND_REFERRAL_INVITED_REWARD_POINTS=500
CHAT_BACKEND_REFERRAL_INVITER_REWARD_POINTS=500
CHAT_BACKEND_DAILY_RESET_TIMEZONE=Asia/Shanghai
CHAT_BACKEND_DISABLE_DEMO_FALLBACK=false

XIAMIMATE_THEME_API_BASE_URL=http://127.0.0.1:18100
XIAMIMATE_THEME_API_KEY=
XIAMIMATE_THEME_API_TIMEOUT=120

DIFY_BASE_URL=
DIFY_CHATBOT_TOKEN=
DIFY_WORKFLOW_APP_API_KEY=
# Deprecated: Dify web-search chatflow is no longer used. Use TAVILY_API_KEY via /internal/provider/web-search/tavily.
# DIFY_WEB_SEARCH_APP_ID=
# DIFY_WEB_SEARCH_APP_API_KEY=
DIFY_DATASET_API_KEY=
DIFY_DATASET_IDS=
DIFY_CUSTOMER_HELP_DATASET_ID=
DIFY_CUSTOMER_HELP_DATASET_API_KEY=
DIFY_REQUEST_TIMEOUT=180

TAVILY_API_KEY=
TAVILY_API_BASE_URL=https://api.tavily.com
TAVILY_REQUEST_TIMEOUT=30
TAVILY_DEFAULT_EXCLUDE_DOMAINS=who13.com,wgntv.com,aol.com,yahoo.com,msn.com,newsweek.com,people.com

# DeepSeek-V4-Pro: OpenAI-compatible line
AGENT_OPENAI_BASE_URL=https://api.deepseek.com
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_MODEL=deepseek-v4-pro
AGENT_OPENAI_TIMEOUT=180
AGENT_OPENAI_TIMEOUT_SECONDS=180

# API易 GPT-5.5: OpenAI Chat Completions-compatible profile selected by bridge provider_profile=apiyi
AGENT_OPENAI_APIYI_ENABLED=true
AGENT_OPENAI_APIYI_BASE_URL=https://api.apiyi.com/v1
AGENT_OPENAI_APIYI_API_KEY=
AGENT_OPENAI_APIYI_MODEL=gpt-5.5
AGENT_OPENAI_APIYI_TIMEOUT_SECONDS=180

# MiniMax-M2.7: Anthropic-compatible line
AGENT_ANTHROPIC_ENABLED=true
AGENT_ANTHROPIC_PROVIDER=anthropic_compatible
AGENT_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
AGENT_ANTHROPIC_API_KEY=
AGENT_ANTHROPIC_MODEL=MiniMax-M2.7-highspeed
AGENT_ANTHROPIC_TIMEOUT_SECONDS=180
AGENT_ANTHROPIC_MAX_TOKENS=4096
AGENT_ANTHROPIC_VERSION=2023-06-01